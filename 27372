<main>

    <section class="produces" id="details">

        <h2 id="name">اسم المنتج</h2>

        <img id="images" src="imges/product2.jpg"
        alt="صورة المنتج" width="250">

        <p id="description">وصف المنتج</p>

        <h3 id="price">السعر</h3>
      <button onclick="addToCart()">
    أضف إلى السلة
</button>



        <a href="products.html">العودة إلى المنتجات</a>

    </section>

