
/* الإعدادات العامة للموقع */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f5e6d3;
    color: #4b2e1e;
    direction: rtl;
    line-height: 1.8;
}

/* عنوان الموقع */
header {
    background-color: #c49a6c;
    color: white;
    text-align: center;
    padding: 20px;
}

header h1 {
    font-size: 30px;
    margin-bottom: 10px;
}

/* روابط التنقل */
nav {
    background-color: #8b5e3c;
    padding: 12px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 10px;
    padding: 8px;
    display: inline-block;
}

nav a:hover {
    background-color: #d2b48c;
    color: #4b2e1e;
    border-radius: 5px;
}

/* محتوى الصفحات */
main {
    padding: 25px;
    min-height: 300px;
}

h2 {
    color: #8b5e3c;
    margin-bottom: 15px;
}

p {
    margin-bottom: 15px;
}

/* الأزرار */
button {
    background-color: #8b5e3c;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
}

button:hover {
    background-color: #6f4529;
}

/* أسفل الصفحة */
footer {
    background-color: #8b5e3c;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: 20px;
}

/* الصور */
img {
    max-width: 100%;
    height: auto;
}

.products {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 8px !important;
    padding: 8px !important;
}

.products .product {
    width: 100% !important;
    min-width: 0 !important;
    padding: 4px !important;
    margin: 0 !important;
    box-sizing: border-box !important;
}

.products .product img {
    width: 100% !important;
    height: 85px !important;
    object-fit: cover !important;
    display: block !important;
}

.products .product h3 {
    font-size: 11px !important;
    margin: 4px 0 !important;
}


/* ===== التنسيق العام لكل الصفحات ===== */

body {
    font-family: Arial, sans-serif;
    background-color: #f5e6d3;
    color: #4b2e1e;
    direction: rtl;
    line-height: 1.8;
    margin: 0;
}

header {
    background-color: #c49a6c;
    color: white;
    text-align: center;
    padding: 25px 15px;
}

header h1 {
    margin: 0 0 8px;
    font-size: 28px;
}

header p {
    margin: 0;
}

/* ===== قائمة التنقل ===== */

nav {
    background-color: #8b5e3c;
    padding: 10px;
    text-align: center;
}

nav a {
    display: inline-block;
    color: white;
    text-decoration: none;
    padding: 6px 10px;
    margin: 3px;
    border-radius: 5px;
}

nav a:hover {
    background-color: #f5e6d3;
    color: #4b2e1e;
}

/* ===== محتوى الصفحات ===== */

main {
    max-width: 1100px;
    margin: auto;
    padding: 20px;
}

h2 {
    color: #8b5e3c;
    text-align: center;
    margin-bottom: 20px;
}

h3 {
    color: #8b5e3c;
}

section {
    margin-bottom: 20px;
}

main section {
    background-color: #fffaf3;
    border: 1px solid #e0c6a5;
    border-radius: 10px;
    padding: 15px;
    margin-bottom: 15px;
}

/* ===== الأزرار ===== */

button,
input[type="submit"] {
    background-color: #8b5e3c;
    color: white;
    border: none;
    padding: 10px 18px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 15px;
}

button:hover,
input[type="submit"]:hover {
    background-color: #654126;
}

/* ===== حقول الإدخال ===== */

input,
textarea,
select {
    width: 100%;
    padding: 10px;
    margin: 6px 0 14px;
    border: 1px solid #c49a6c;
    border-radius: 6px;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
    font-size: 15px;
}

textarea {
    min-height: 100px;
    resize: vertical;
}

label {
    display: block;
    font-weight: bold;
}

/* ===== بطاقات المنتجات ===== */

.products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    padding: 10px;
}

.products h2 {
    grid-column: 1 / -1;
}

.products .product {
    background-color: #fffaf3;
    border: 1px solid #d2b48c;
    border-radius: 8px;
    padding: 6px;
    margin: 0;
    min-width: 0;
    text-align: center;
    box-sizing: border-box;
}

.products .product img {
    display: block;
    width: 100%;
    height: 100px;
    object-fit: cover;
    border-radius: 5px;
}

.products .product h3 {
    font-size: 13px;
    margin: 5px 0;
}

/* ===== تفاصيل المنتج ===== */

.product-details {
    max-width: 700px;
    margin: 20px auto;
    padding: 20px;
    background-color: #fffaf3;
    border-radius: 12px;
}

.product-details img {
    width: 100%;
    max-width: 350px;
    height: auto;
    display: block;
    margin: 15px auto;
    border-radius: 10px;
}

/* ===== نموذج تسجيل الدخول والاتصال ===== */

.login-form,
.contact-form {
    max-width: 450px;
    margin: 25px auto;
    padding: 20px;
    background-color: #fffaf3;
    border: 1px solid #d2b48c;
    border-radius: 12px;
}

/* ===== أسفل الصفحة ===== */

footer {
    background-color: #8b5e3c;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: 25px;
}

footer p {
    margin: 0;
}

/* ===== تنسيق الموبايل ===== */

@media (max-width: 600px) {
    header h1 {
        font-size: 23px;
    }

    nav a {
        padding: 5px 7px;
        margin: 2px;
        font-size: 13px;
    }

    main {
        padding: 12px;
    }

    .products {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 6px;
        padding: 5px;
    }

    .products .product {
        padding: 4px;
    }

    .products .product img {
        height: 85px;
    }

    .products .product h3 {
        font-size: 11px;
    }

    .login-form,
    .contact-form {
        padding: 12px;
    }
}

/* إجبار صور المنتجات على الظهور في أعمدة */
body .products {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 8px !important;
    width: 100% !important;
    padding: 8px !important;
    box-sizing: border-box !important;
}

body .products > .product {
    display: block !important;
    width: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 5px !important;
    box-sizing: border-box !important;
}

body .products > .product img {
    display: block !important;
    width: 100% !important;
    height: 90px !important;
    object-fit: cover !important;
}

body .products > .product h3 {
    font-size: 11px !important;
    text-align: center;
}
