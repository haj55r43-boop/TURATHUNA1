/* ===== الإعدادات العامة ===== */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f5e6d37b;
    color: #4b2e1e;
    direction: rtl;
    line-height: 1.8;
}

/* ===== رأس الموقع ===== */
header {
    background-color: #c49a6c;
    color: brond;
    text-align: center;
    padding: 20px 15px;
}

header h1 {
    font-size: 26px;
    margin-bottom: 8px;
}

header p {
    margin: 0;
}

/* ===== قائمة التنقل ===== */
nav {
    background-color: #8b5e3c;
    padding: 10px;
    text-align: center;
}

nav a {
    display: inline-block;
    color: brown;
    text-decoration: none;
    padding: 6px 10px;
    margin: 3px;
    border-radius: 5px;
}

nav a:hover {
    background-color: #d2b48c;
    color: #4b2e1e;
}

/* ===== محتوى الصفحات ===== */
main {
    max-width: 1100px;
    min-height: 300px;
    margin: auto;
    padding: 20px;
}

h2 {
    color: #8b5e3c;
    text-align: center;
    margin-bottom: 15px;
}

h3 {
    color: #8b5e3c;
}

p {
    margin-bottom: 15px;
}

section {
    margin-bottom: 20px;
}

main section {
    background-color: #fffaf3;
    border: 1px solid #e0c6a5;
    border-radius: 10px;
    padding: 15px;
}

/* ===== الأزرار ===== */
button,
input[type="submit"] {
    background-color: #8b5e3c;
    color: brown;
    border: none;
    padding: 10px 18px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 15px;
}

button:hover,
input[type="submit"]:hover {
    background-color: #654126;
}

/* ===== حقول الإدخال ===== */
input,
textarea,
select {
    width: 100%;
    padding: 10px;
    margin: 6px 0 14px;
    border: 1px solid #c49a6c;
    border-radius: 6px;
    font-family: Arial, sans-serif;
    font-size: 15px;
}

textarea {
    min-height: 100px;
    resize: vertical;
}

label {
    display: block;
    font-weight: bold;
}

/* ===== الصور العامة ===== */
img {
    max-width: 100%;
    height: auto;
}

/* ===== بطاقات المنتجات ===== */
.products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 8px;
}

.products h2 {
    grid-column: 1 / -1;
}

.products .product {
    background-color: #fffaf3;
    border: 1px solid #d2b48c;
    border-radius: 8px;
    padding: 4px;
    text-align: center;
    min-width: 0;
}

.products .product img {
    display: block;
    width: 100%;
    height: 65px;
    object-fit: cover;
    border-radius: 5px;
}

.products .product h3 {
    font-size: 11px;
    margin: 4px 0;
}

/* ===== تفاصيل المنتج ===== */
.product-details {
    max-width: 700px;
    margin: 20px auto;
    padding: 20px;
    background-color: #fffaf3;
    border-radius: 12px;
}

.product-details img {
    width: 100%;
    max-width: 300px;
    display: block;
    margin: 15px auto;
    border-radius: 10px;
}

/* ===== تسجيل الدخول والاتصال ===== */
.login-form,
.contact-form {
    max-width: 450px;
    margin: 25px auto;
    padding: 20px;
    background-color: #fffaf3;ممكن ترسل الكود مرة تانية
    border: 1px solid #d2b48c;
    border-radius: 12px;
}

/* ===== أسفل الموقع ===== */
footer {
    background-color: #8b5e3c;
    color: brown;
    text-align: center;
    padding: 15px;
    margin-top: 20px;
}

footer p {
    margin: 0;
}

/* ===== تنسيق شاشات الهاتف ===== */
@media (max-width: 600px) {
    header h1 {
        font-size: 23px;
    }

    nav a {
        padding: 5px 6px;
        margin: 2px;
        font-size: 12px;
    }

    main {
        padding: 10px;
    }

    .products {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 6px;
        padding: 5px;
    }

    .products .product img {
        height: 60px;
    }

    .products .product h3 {
        font-size: 10px;
    }

    .login-form,
    .contact-form {
        padding: 12px;
    }
}
